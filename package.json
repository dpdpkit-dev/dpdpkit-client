{
  "name": "@dpdpkit/client",
  "version": "0.1.0-alpha.1",
  "description": "Typed TypeScript client for the dpdpkit REST contract (India DPDP Act consent, notices, rights requests).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpdpkit-dev/dpdpkit-client.git"
  },
  "keywords": [
    "dpdp",
    "privacy",
    "consent",
    "india",
    "openapi"
  ],
  "scripts": {
    "sync-spec": "node scripts/sync-spec.mjs",
    "generate": "npm ci --prefix scripts/codegen --no-audit --no-fund && node scripts/codegen/node_modules/openapi-typescript/bin/cli.js spec/openapi.yaml -o src/schema.ts",
    "check:generated": "npm run generate && git diff --exit-code -- src/schema.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
